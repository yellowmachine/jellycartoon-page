---
import Tarjeta from '../components/Tarjeta.astro';
import Version from '../components/Version.astro';
import Base from '../layouts/Base.astro';
import { cargarIcono } from '../lib/iconos';
import { cargarNovedades, ultimaVersion } from '../lib/novedades';
import { ruta } from '../lib/rutas';
import { agrupar, cargarWeb } from '../lib/web';

const { producto, funciones } = await cargarWeb();
const grupos = agrupar(funciones);
const ultima = ultimaVersion(await cargarNovedades());
const iconoCasa = await cargarIcono('house');
const iconoNube = await cargarIcono('cloud');
---

<Base descripcion={producto.descripcion} producto={producto} actual="inicio">
	<section class="portada" aria-labelledby="lema">
		<div class="contenedor portada__rejilla">
			<div class="portada__texto">
				<h1 id="lema">{producto.lema}</h1>
				<p class="entradilla">{producto.descripcion}</p>
				{
					producto.instalar_comando && (
						<div class="portada__instalar">
							<p>En una terminal del ordenador de casa:</p>
							<pre class="comando"><code>{producto.instalar_comando}</code></pre>
						</div>
					)
				}
				<p class="acciones">
					<a class="boton" href={ruta('instalar/')}>Cómo instalarla</a>
					<a class="boton boton--secundario" href={producto.repositorio}>Código en GitHub</a>
				</p>
			</div>
			<img class="portada__icono" src={ruta('favicon.svg')} alt="" width="320" height="320" />
		</div>
	</section>

	<section class="seccion" aria-labelledby="para-quien">
		<div class="contenedor contenedor--estrecho">
			<h2 id="para-quien">Para quién es</h2>
			<p class="entradilla">{producto.para_quien}</p>
		</div>
	</section>

	<section class="seccion" aria-labelledby="funciones">
		<div class="contenedor">
			<h2 id="funciones">Qué hace</h2>
			{
				grupos.map((grupo) => (
					<div class="grupo">
						<h3 class="grupo__titulo">{grupo.titulo}</h3>
						<div class="rejilla">
							{grupo.funciones.map((funcion) => (
								<Tarjeta funcion={funcion} nivel={4} />
							))}
						</div>
					</div>
				))
			}
		</div>
	</section>

	{
		(producto.en_casa || producto.nube) && (
			<section class="seccion" aria-label="En casa y fuera de casa">
				<div class="contenedor columnas">
					{producto.en_casa && (
						<div class="columna">
							<h2>
								<Fragment set:html={iconoCasa} />
								Tuya, en tu casa
							</h2>
							<p>{producto.en_casa}</p>
						</div>
					)}
					{producto.nube && (
						<div class="columna">
							<h2>
								<Fragment set:html={iconoNube} />
								Fuera de casa, con Seilide
							</h2>
							<p>{producto.nube}</p>
							{producto.nube_url && (
								<p>
									<a href={producto.nube_url}>Conoce Seilide</a>
								</p>
							)}
						</div>
					)}
				</div>
			</section>
		)
	}

	{
		ultima && (
			<section class="seccion" aria-labelledby="ultima-version">
				<div class="contenedor contenedor--estrecho">
					<h2 id="ultima-version">Última versión</h2>
					<Version version={ultima} nivel={3} />
					<p>
						<a href={ruta('novedades/')}>Todas las novedades</a>
					</p>
				</div>
			</section>
		)
	}
</Base>
